# Скопируй в .env и заполни своими ключами. .env не коммитится (см. .gitignore).

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
CARTESIA_API_KEY=

# Опционально: голос Cartesia (id из playground.cartesia.ai), модель через OpenRouter.
CARTESIA_VOICE_ID=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
