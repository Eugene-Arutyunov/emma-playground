# Скопируй в .env и заполни своими ключами. .env не коммитится (см. .gitignore).

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
CARTESIA_API_KEY=

# Логин и пароль для входа в прототип (страница /login), общие для команды.
# Нужны только token-серверу (server.py).
EMMA_AUTH_USER=
EMMA_AUTH_PASSWORD=

# Опционально: модель второго канала («что Эмма замечает») и папка для транскриптов.
EMMA_REFLECTION_MODEL=anthropic/claude-haiku-4.5
EMMA_TRANSCRIPTS_DIR=transcripts
