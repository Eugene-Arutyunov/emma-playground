# Скопируй в .env и заполни своими ключами. .env не коммитится (см. .gitignore).

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Логин и пароль для входа в прототип (страница /login), общие для команды.
# Нужны только token-серверу (server.py).
EMMA_AUTH_USER=
EMMA_AUTH_PASSWORD=

# Опционально: папка для транскриптов.
EMMA_TRANSCRIPTS_DIR=transcripts

# Velma (Modulate): второе ухо Эммы, акустические эмоции и бихейверы.
# Без ключа воркер работает как раньше, сигналы настроения приходят только
# от тестовых кнопок на странице (?dev). Ключ: platform.modulate.ai → API Keys.
MODULATE_API_KEY=
# Опционально: другой адрес Velma streaming (внутренний стенд и т.п.).
# VELMA_STREAMING_URL=wss://platform.modulate.ai/api/velma-2-streaming
